                },
                {
                    "id": "31623a91-b42e-4135-b92b-808af09f70cd",
                    "notes": "An item I personally get lots of value out of due to its snowball potential. If you don't feel the composition has many weak points, take another $1500 item, like [Siphon Gloves] over this.",
                    "action": "buy",
                    "upgrade_id": "d4b0cfcb-14e9-4472-a688-680120217250"
                },
                {
                    "id": "9f4cd02b-ca06-4d51-a692-8c9a04f1f2e1",
                    "notes": "Benefits knife and carnage which should be used the second they come up, so expect a lot of value from this item.",
                    "action": "buy",
                    "upgrade_id": "6d8803cf-baa7-46ee-af91-51e7f2301418"
                },
                {
                    "id": "d641d247-f184-4cec-836a-59c6be5a9837",
                    "notes": "A very flexible pick. If you have another $1000 item you prefer, take it over this. This build is not very gun heavy at all, so any ability lifesteal is also welcome.",
                    "action": "buy",
                    "upgrade_id": "2a354f80-610c-4661-9bdd-8960ae1a60b0"
                },
                {
                    "id": "a31b5e40-f6c3-4ac5-b7f2-305c54959595",
                    "notes": "Another item you will constant value out of, but only if you have supports who are a bit weaker on the single-target healing side of things.",
                    "action": "optional",
                    "upgrade_id": "099f8177-c2a4-4e13-b321-99349f8b1eb7"
                }
            ]
        },
        {
            "id": "6258bbad-8b72-425e-8c70-ffb0318c2109",
            "build_id": "9b231275-b62e-4c37-adb1-c77c1e8218a9",
