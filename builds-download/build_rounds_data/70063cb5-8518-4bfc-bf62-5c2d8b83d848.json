                {
                    "id": "cf15e88f-fc0f-4ac7-bf69-7213af06d2af",
                    "notes": "Get more shots in, more chances of getting a kill.",
                    "action": "buy",
                    "upgrade_id": "2485b212-b286-42d0-a2bd-20eb4396b054"
                },
                {
                    "id": "42881682-b631-4549-a633-ceb0509821e8",
